local function Button(page, text, cb)
	local b = New("TextButton", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, BorderSizePixel = 0,
		Text = text, TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false, ZIndex = 4}, page)
	Corner(b, 10)
	local s = Stroke(b, WHITE, 1, 0.92)
	b.MouseEnter:Connect(function() Tween(b, 0.15, {BackgroundTransparency = 0.78}) s.Color = Accent Tween(s, 0.15, {Transparency = 0.2}) end)
	b.MouseLeave:Connect(function() Tween(b, 0.15, {BackgroundTransparency = 0.9}) s.Color = WHITE Tween(s, 0.15, {Transparency = 0.92}) end)
	b.MouseButton1Click:Connect(function()
		Click()
		Tween(b, 0.08, {Size = UDim2.new(1, -6, 0, 38)}).Completed:Connect(function() Tween(b, 0.12, {Size = UDim2.new(1, 0, 0, 40)}) end)
		if cb then task.spawn(cb, b) end
	end)
	return b
end

local function Toggle(page, text, default, cb)
	local c = Card(page, 40)
	New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 1, 0), Text = text,
		TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5}, c)
	local hit = New("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 6}, c)
	local pill = New("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(40, 20),
		BackgroundColor3 = Color3.fromRGB(70, 70, 78), BorderSizePixel = 0, ZIndex = 5}, c)
	Corner(pill, 10)
	local knob = New("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 6}, pill)
	Corner(knob, 8)
	local on = default and true or false
	local function Render()
		Tween(pill, 0.2, {BackgroundColor3 = on and Accent or Color3.fromRGB(70, 70, 78)})
		Tween(knob, 0.2, {Position = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)})
	end
	OnAccent(function() if pill.Parent then pill.BackgroundColor3 = on and Accent or Color3.fromRGB(70, 70, 78) end end)
	Render()
	hit.MouseButton1Click:Connect(function()
		Click()
		on = not on
		Render()
		task.spawn(cb, on)
	end)
	return c
end

-- button with a live "PHONK ON / PHONK OFF" label on the right
local function StateButton(page, title, onClick)
	local b = New("TextButton", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, BorderSizePixel = 0,
		Text = "", AutoButtonColor = false, ZIndex = 4}, page)
	Corner(b, 10)
	local st = Stroke(b, WHITE, 1, 0.92)
	New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -140, 1, 0), Text = title,
		TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5}, b)
	local label = New("TextLabel", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(120, 22),
		BackgroundTransparency = 1, Text = "PHONK OFF", TextColor3 = Color3.fromRGB(150, 150, 160), Font = Enum.Font.GothamBlack, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5}, b)
	local state = "OFF"
	local function Render()
		if state == "ON" then
			label.Text, label.TextColor3 = "PHONK ON", Accent
			b.BackgroundTransparency = 0.78
			st.Color, st.Transparency = Accent, 0.2
		elseif state == "LOADING" then
			label.Text, label.TextColor3 = "LOADING...", Color3.fromRGB(255, 210, 90)
			b.BackgroundTransparency = 0.85
			st.Color, st.Transparency = WHITE, 0.92
		elseif state == "NEED PACK" then
			label.Text, label.TextColor3 = "RUN PHONK PACK", Color3.fromRGB(255, 150, 60)
			b.BackgroundTransparency = 0.9
			st.Color, st.Transparency = WHITE, 0.92
		elseif state == "ERROR" then
			label.Text, label.TextColor3 = "NOT SUPPORTED", Color3.fromRGB(255, 90, 90)
			b.BackgroundTransparency = 0.9
			st.Color, st.Transparency = WHITE, 0.92
		else
			label.Text, label.TextColor3 = "PHONK OFF", Color3.fromRGB(150, 150, 160)
			b.BackgroundTransparency = 0.9
			st.Color, st.Transparency = WHITE, 0.92
		end
	end
	OnAccent(function() if b.Parent then Render() end end)
	local function SetState(v) state = v Render() end
	b.MouseButton1Click:Connect(function() Click() onClick(SetState) end)
	return SetState
end

local function Slider(page, text, min, max, default, cb)
	local c = Card(page, 54)
	local label = New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -24, 0, 22),
		Text = text .. "  •  " .. default, TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5}, c)
	local track = New("Frame", {Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 5}, c)
	Corner(track, 3)
	local fill = New("Frame", {Size = UDim2.fromScale((default - min) / (max - min), 1), BackgroundColor3 = Accent, BorderSizePixel = 0, ZIndex = 6}, track)
	Corner(fill, 3)
	OnAccent(function(col) fill.BackgroundColor3 = col end)
	local knob = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 7}, fill)
	Corner(knob, 7)
	local dragging = false
	local function Set(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + (max - min) * a + 0.5)
		fill.Size = UDim2.fromScale(a, 1)
		label.Text = text .. "  •  " .. v
		task.spawn(cb, v)
	end
	local hit = New("TextButton", {Position = UDim2.new(0, 6, 0, 26), Size = UDim2.new(1, -12, 0, 22), BackgroundTransparency = 1, Text = "", ZIndex = 8}, c)
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			Set(i.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Set(i.Position.X) end
	end)
	return c
end

