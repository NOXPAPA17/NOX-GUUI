	table.insert(Pages, page)
	local idx = #Pages
	local b = New("TextButton", {Size = UDim2.new(1, -14, 0, 38), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
		Text = "", AutoButtonColor = false, ZIndex = 4}, Sidebar)
	Corner(b, 10)
	local bar = New("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(3, 4),
		BackgroundColor3 = Accent, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5}, b)
	Corner(bar, 2)
	OnAccent(function(c) bar.BackgroundColor3 = c end)
	New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(24, 38), Text = icon,
		TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 16, ZIndex = 5}, b)
	local label = New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -46, 1, 0), Text = text,
		TextColor3 = WHITE, TextTransparency = 0.35, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 5}, b)
	b.MouseButton1Click:Connect(function() Click() SelectTab(idx) end)
	b.MouseEnter:Connect(function() if not page.Visible then Tween(b, 0.15, {BackgroundTransparency = 0.92}) end end)
	b.MouseLeave:Connect(function() if not page.Visible then Tween(b, 0.15, {BackgroundTransparency = 1}) end end)
	table.insert(Tabs, {Button = b, Bar = bar, Label = label})
	return page
end

-- controls
local function Card(page, height)
